# Copy this file to .env and replace every placeholder before starting.
POSTGRES_DB=sewing_workshop
POSTGRES_USER=sewing_app
POSTGRES_PASSWORD=replace_with_a_strong_password
JWT_SECRET=replace_with_a_long_random_secret

# Use localhost for local testing or a domain name for deployment.
APP_DOMAIN=localhost

# Optional: creates generic demonstration accounts and sample production data.
# Never enable this setting in a production environment.
SEED_DEMO_DATA=false
